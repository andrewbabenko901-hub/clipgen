// =====================================================================
// clipgen.scad — единое ядро генератора автомобильных клипс
// ClipBase / Kraunfanding · срез данных 30 августа 2026
//
// Пять моделей на одном ядре. Переключатель model:
//   "firtree"      ёлочка, круглое отверстие, стопка рёбер          (Volt)
//   "push"         пистон 8 мм, 2 крупных ребра, толстый стержень   (DISCO S14)
//   "grommet"      закладная гайка, КВАДРАТНОЕ отверстие            (Nifco)
//   "weatherstrip" клипса уплотнителя, прямоугольная голова 5x15    (DISCO S13)
//   "hood"         пистон шумоизоляции, большая голова, короткий шток
//
// Всё построено на общих кирпичах: голова, шток, рёбра, юбка.
// Отличаются только числа и форма головы — поэтому одно ядро, а не пять.
//
// ИСТОЧНИКИ ЧИСЕЛ
//   Всё, что помечено [Volt], [DISCO], [Nifco], взято из каталогов.
//   Всё, что помечено [ДОПУЩЕНИЕ], нигде не опубликовано и требует
//   подтверждения печатью. Не выдавать эти значения за спецификацию.
//
// СИСТЕМА КООРДИНАТ
//   z = 0   плоскость панели, на которую ложится голова
//   z < 0   голова
//   z > 0   шток, кончик смотрит вверх, вставка идёт в сторону +z
// =====================================================================

model = "firtree";
mode  = "solid";     // solid | section | in_hole

// ---------------------------------------------------------------------
// ВХОДНЫЕ ПАРАМЕТРЫ
// Пустое значение -1 означает «посчитать по правилу семейства».
// ---------------------------------------------------------------------

hole_d      = 7.92;  // номинальное отверстие в панели, мм
panel_min   = 1.57;  // тонкая граница пакета
panel_max   = 6.35;  // толстая граница пакета

head_d      = -1;    // диаметр круглой головы; -1 = по правилу семейства
head_w      = -1;    // ширина прямоугольной головы (weatherstrip)
head_l      = -1;    // длина прямоугольной головы
head_t      = 1.8;   // толщина головы [DISCO, Nifco]
head_r_corner = 1.2; // скругление углов прямоугольной головы

stem_d      = -1;    // диаметр стержня; -1 = по правилу семейства
stem_len    = -1;    // длина штока от плоскости панели; -1 = по правилу

barb_count  = -1;    // число рёбер; -1 = по правилу
barb_d      = -1;    // НАРУЖНЫЙ диаметр ребра; -1 = hole_d + interference
interference = -1;   // натяг ПО ДИАМЕТРУ, мм; -1 = по правилу семейства
barb_root_t = -1;    // осевая толщина ребра у основания; -1 = по правилу.
                     // [Volt] у ёлочек это КОНСТАНТА 2.03-2.54 на всех 22 артикулах
barb_pitch  = -1;    // шаг рёбер; -1 = по правилу
rake_out    = 10;    // угол удерживающей грани от перпендикуляра, град [ДОПУЩЕНИЕ]
rake_in_tgt = 32;    // желаемый угол захода от оси, град [ДОПУЩЕНИЕ, норма 25-40].
                     // Используется там, где толщина основания не опубликована

tip_len     = -1;    // длина носика; -1 = по правилу
seal_skirt  = false; // коническая юбка-пружина под головой
skirt_d     = -1;
skirt_t     = 0.9;

// закладная гайка
body_w      = -1;    // сторона квадратного корпуса
body_len    = -1;    // длина корпуса [Nifco: Open 5-12, Closed 11-19]
screw_d     = 5.0;   // условный диаметр самореза [Nifco: 4/5/6]
grommet_closed = false;  // закрытый (водонепроницаемый) вариант
wing_out    = -1;    // насколько крыло выходит за габарит корпуса

$fn = 96;

// =====================================================================
// ПРАВИЛА СЕМЕЙСТВ — то, что вытащено из таблиц
// =====================================================================

// Голова к отверстию. Ёлочки заметно «головастее» пистонов.
//   [Volt]  ёлочка: 2.67-2.85 на 22 артикулах
//   [DISCO] пистон:  2.0-2.5
f_head_ratio =
    model == "firtree" ? 2.80 :
    model == "push"    ? 2.40 :
    model == "hood"    ? 4.30 :   // [DISCO S13] голова 30 при отверстии 7
                         2.40;

// Длина штока.
//   [Volt]  ёлочка: шток = макс.панель + (0.48...0.56) x отверстие
//   [DISCO] пистон: шток = макс.захват + 13   (Ford/GM, три семейства)
f_stem_len =
    model == "firtree"      ? panel_max + 0.52 * hole_d :
    model == "push"         ? panel_max + 13 :
    model == "weatherstrip" ? panel_max + 6 :      // [DISCO S13] штоки 5-17
    model == "hood"         ? panel_max + 11 :     // Toyota 90467-09008: 17 при панели 6
                              panel_max + 8;

// Натяг по диаметру.
//   [Volt] 0.33-0.69; семейство 7.92 идёт ровно на 0.34 на всех шести
f_interference =
    model == "firtree" ? (hole_d > 7.6 && hole_d < 8.2 ? 0.34 : 0.55) :
    model == "push"    ? 0.40 :
                         0.45;

// Диаметр стержня.
//   [DISCO] пистон: стержень почти заполняет отверстие, работают только рёбра
//   [ДОПУЩЕНИЕ] ёлочка: стержень тоньше, рёбра длиннее и гибче
f_stem_d =
    model == "push"    ? hole_d - 0.3 :
    model == "firtree" ? hole_d * 0.60 :
                         hole_d * 0.62;

f_barb_count =
    model == "firtree"      ? 5 :   // [Volt] 4-7 рёбер
    model == "push"         ? 2 :   // [DISCO] крупные крылья
    model == "weatherstrip" ? 3 :
    model == "hood"         ? 4 : 3;

// =====================================================================
// РАЗРЕШЕНИЕ ПАРАМЕТРОВ
// =====================================================================
H_D   = head_d      > 0 ? head_d      : hole_d * f_head_ratio;
S_D   = stem_d      > 0 ? stem_d      : f_stem_d;
S_LEN = stem_len    > 0 ? stem_len    : f_stem_len;
INTF  = interference > 0 ? interference : f_interference;
B_D   = barb_d      > 0 ? barb_d      : hole_d + INTF;
N_B   = barb_count  > 0 ? barb_count  : f_barb_count;
TIP   = tip_len     > 0 ? tip_len     : max(1.5, hole_d * 0.30);
SK_D  = skirt_d     > 0 ? skirt_d     : H_D * 1.10;

HW    = head_w      > 0 ? head_w      : 5.0;    // [DISCO S13] доминирующая
HL    = head_l      > 0 ? head_l      : 15.0;   // голова 5.00x15.00, 20 строк из 71

BW    = body_w      > 0 ? body_w      : hole_d;            // квадрат в квадрат
BLEN  = body_len    > 0 ? body_len    : (grommet_closed ? 14.0 : 8.0); // [Nifco]
WOUT  = wing_out    > 0 ? wing_out    : 0.9;   // [ДОПУЩЕНИЕ]

// Шаг рёбер: рабочая зона равна разбросу пакета, но шаг держим в 1.5-3.0
_pitch_raw = barb_pitch > 0 ? barb_pitch
           : (N_B > 1 ? (panel_max - panel_min) / (N_B - 1) : 2.0);
B_R   = B_D / 2;
S_R   = S_D / 2;
H_R   = H_D / 2;
d_r   = B_R - S_R;                        // вылет ребра по радиусу

// Геометрия ребра.
// У ёлочки толщина основания опубликована [Volt] — она задаёт угол захода.
// У остальных семейств не опубликована — тогда наоборот, задаём угол захода,
// а толщину основания получаем.
back_len = d_r * tan(rake_out);                    // удерживающая грань
_root_t  = barb_root_t > 0 ? barb_root_t
         : (model == "firtree" ? 2.5 : back_len + d_r / tan(rake_in_tgt));
ROOT_T   = _root_t;
ramp_len = max(0.3, ROOT_T - back_len);            // заходной скат
rake_in  = atan(d_r / ramp_len);                   // угол захода от оси

// Шаг рёбер держим в 1.5-3.0 и не даём ему стать меньше самого ребра
P_B   = max(1.5, min(3.0, max(_pitch_raw, ROOT_T + 0.2)));

first_barb_z = panel_max + 0.4 + back_len;         // рабочее ребро сразу за панелью

// =====================================================================
// КОНТРОЛЬ — печатается при каждом рендере
// =====================================================================
echo(str("=== ", model, " ==="));
echo(str("отверстие ", hole_d, "  панель ", panel_min, "-", panel_max));
echo(str("голова ", H_D, " (", H_D/hole_d, " x отв)   шток ", S_LEN));
echo(str("стержень ", S_D, "  ребро ", B_D, "  вылет по радиусу ", d_r));
echo(str("натяг по диаметру ", INTF, "  на сторону ", INTF/2));
echo(str("рёбер ", N_B, "  шаг ", P_B, "  толщина основания ", ROOT_T));
echo(str("угол захода ", rake_in, " град (норма 25-40), удержание ", rake_out));
assert(d_r > 0.05, "ребро не выступает за стержень — проверь stem_d и barb_d");
assert(S_LEN > panel_max + 1, "шток короче пакета панелей");

// =====================================================================
// КИРПИЧИ
// =====================================================================

// Одно ребро-кольцо. zt — высота максимального радиуса.
module barb_ring(zt) {
    rotate_extrude()
        polygon([
            [S_R * 0.99, zt + ramp_len],
            [B_R,        zt           ],
            [S_R * 0.99, zt - back_len]
        ]);
}

module barb_stack() {
    for (i = [0 : N_B - 1]) {
        zt = first_barb_z + i * P_B;
        if (zt + ramp_len <= S_LEN - 0.2) barb_ring(zt);
    }
}

module stem_body() {
    cylinder(h = S_LEN - TIP, d = S_D);
    translate([0, 0, S_LEN - TIP])
        cylinder(h = TIP, d1 = S_D, d2 = max(1.2, S_D * 0.45));
}

// Плоская голова: круглая или прямоугольная со скруглением
module head_plate() {
    translate([0, 0, -head_t])
    if (model == "weatherstrip") {
        r = min(head_r_corner, HW / 2 - 0.1);
        hull() for (dx = [-1, 1], dy = [-1, 1])
            translate([dx * (HL/2 - r), dy * (HW/2 - r), 0])
                cylinder(h = head_t, r = r);
    } else {
        cylinder(h = head_t, d = H_D);
    }
}

// Юбка-пружина: тонкий конус от нижней кромки головы к панели.
// Она выбирает разброс толщины панели и даёт уплотнение.
module spring_skirt() {
    rotate_extrude()
        polygon([
            [H_R - 0.01, -head_t          ],
            [SK_D / 2,   -0.05            ],
            [SK_D / 2 - skirt_t, -0.05    ],
            [H_R - 0.01, -head_t + skirt_t]
        ]);
}

module head_all() {
    head_plate();
    if (seal_skirt && model != "weatherstrip") spring_skirt();
}

// ---- закладная гайка -------------------------------------------------
// Корпус-параллелепипед в квадратное отверстие, по бокам два крыла,
// которые заходят за панель. Внутри осевая полость под саморез.
// [ДОПУЩЕНИЕ] внутренняя геометрия крыльев нигде не опубликована,
// сделано по описанию US4293260A, а не по размерам.
// Крыло: наклонная лапка шириной в корпус. Верхом врастает в корпус,
// низ висит свободно — это и есть шарнир из US4293260A. Печатается как
// одно тело, гибкость даёт тонкое сечение у корня.
module grommet_wing(s) {
    z_top = BLEN - 1.6;                 // где крыло срастается с корпусом
    z_bot = panel_max + 0.8;            // свободный низ, упор в обратную сторону панели
    translate([0, BW/2, 0]) rotate([90, 0, 0])
        linear_extrude(height = BW)
            polygon([
                [s * (BW/2 - 0.8),        z_top      ],
                [s * (BW/2 + WOUT),       z_bot + 1.0],
                [s * (BW/2 + WOUT - 0.7), z_bot      ],
                [s * (BW/2 - 0.8),        z_top - 1.6]
            ]);
}

module grommet_body() {
    difference() {
        union() {
            translate([-BW/2, -BW/2, 0]) cube([BW, BW, BLEN]);
            for (s = [-1, 1]) grommet_wing(s);
        }
        // полость под саморез: у открытого варианта насквозь,
        // у закрытого — глухая, поэтому он и водонепроницаемый
        translate([0, 0, -0.01])
            cylinder(h = grommet_closed ? BLEN - 1.2 : BLEN + 0.02,
                     d = screw_d * 0.80);
    }
}

// =====================================================================
// СБОРКА
// =====================================================================
module clip() {
    if (model == "grommet") {
        union() { head_all(); grommet_body(); }
    } else {
        union() { head_all(); stem_body(); barb_stack(); }
    }
}

module panel() {
    color("silver", 0.35)
    difference() {
        translate([-H_D - 2, -H_D - 2, 0]) cube([2*H_D + 4, 2*H_D + 4, panel_max]);
        if (model == "grommet")
            translate([-hole_d/2, -hole_d/2, -0.01]) cube([hole_d, hole_d, panel_max + 0.02]);
        else
            translate([0, 0, -0.01]) cylinder(h = panel_max + 0.02, d = hole_d);
    }
}

// =====================================================================
if (mode == "solid") {
    clip();
} else if (mode == "section") {
    difference() {
        clip();
        translate([-H_D*2, 0, -H_D*2]) cube([H_D*4, H_D*2, S_LEN + H_D*4]);
    }
} else if (mode == "in_hole") {
    clip();
    panel();
}
